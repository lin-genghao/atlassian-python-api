class="codeContent panelContent pdl hide-toolbar"> \n  <pre class="syntaxhighlighter-pre" data-syntaxhighlighter-params="brush: py; gutter: true; theme: Midnight; collapse: true" data-theme="Midnight">#! /usr/bin/env python\n# coding=utf-8\n\n\nimport roslib\nfrom dynamic_reconfigure.parameter_generator_catkin import *\n\nPACKAGE = &quot;px4ctrl&quot;\nroslib.load_manifest(PACKAGE)\n\n# 创建一个参数生成器\ngen = ParameterGenerator()\n\n# 添加参数说明，便于后续生成界面\n#      参数名        类型           等级       参数描述                默认值          最小值         最大值\ngen.add(&quot;p&quot;,        double_t,        0,        &quot;KP param.&quot;,            2.5,            -10.00,        10.00)\ngen.add(&quot;i&quot;,        double_t,        0,  
      &quot;KI param.&quot;,            0.0,            -10.00,        10.00)\ngen.add(&quot;d&quot;,        double_t,        0,        &quot;KD param.&quot;,            20.0,  
         -100.00,      100.00)\ngen.add(&quot;px&quot;,       double_t,        0,        &quot;PX param.&quot;,            0.0,            -10.00,        10.00)\ngen.add(&quot;py&quot;,       double_t,        0,        &quot;PY param.&quot;,            0.0,            -10.00,        10.00)\ngen.add(&quot;pz&quot;,       double_t,        0,        &quot;PZ param.&quot;,            0.0,            -10.00,        10.00)\n# 调用生成器生成config配置文件\n#                 包名      节点名称    生成文件名\nexit(gen.generate(PACKAGE, PACKAGE, &quot;PID&quot;))</pre> \n </div>\n</div><p>chmod +x xxx.cfg添加权限</p><p>编译会生成头文件</p><p><span class="confluence-embedded-file-wrapper confluence-embedded-manual-size"><img class="confluence-embedded-image confluence-thumbnail" height="250" src="/download/thumbnails/77136432/image2024-4-23_9-59-44.png?version=1&amp;modificationDate=1713837584000&amp;api=v2" data-image-src="/download/attachments/77136432/image2024-4-23_9-59-44.png?version=1&amp;modificationDate=1713837584000&amp;api=v2" data-unresolved-comment-count="0" data-linked-resource-id="77136486" data-linked-resource-version="1" data-linked-resource-type="attachment" data-linked-resource-default-alias="image2024-4-23_9-59-44.png" data-base-url="http://confluence.mmcuav.com:8002" data-linked-resource-content-type="image/png" data-linked-resource-container-id="77136432" data-linked-resource-container-version="8"></span></p><h4 id="ROS-动态调参-调用">调用</h4><div class="code panel pdl conf-macro output-block" data-hasbody="true" data-macro-name="code" style="border-width: 1px;">\n <div class="codeHeader panelHeader pdl hide-border-bottom">\n  <b class="code-title"> </b>\n  <span class="collapse-source expand-control" style="display:none;"><span 
class="expand-control-icon icon">\xa0</span><span class="expand-control-text">Expand source</span></span>\n  <span class="collapse-spinner-wrapper"> </span>\n </div>\n <div class="codeContent panelContent pdl hide-toolbar"> \n  <pre class="syntaxhighlighter-pre" data-syntaxhighlighter-params="brush: java; gutter: false; theme: Midnight; collapse: true" data-theme="Midnight">#include &quot;dynamic_reconfigure/server.h&quot;\n#include &quot;px4ctrl/PIDConfig.h&quot;\n\nnamespace mmc_ctrl {\nclass PX4CtrlFSM {\npublic:\n\t...\n\n    // 创建服务器对象\n    dynamic_reconfigure::Server&lt;px4ctrl::PIDConfig&gt; server;\n    // 创建回调对象(使用回调函数，打印修改后的参数)\n    dynamic_reconfigure::Server&lt;px4ctrl::PIDConfig&gt;::CallbackType cbType;\n\tfloat pose_ctrl_p;\n    float pose_ctrl_i;\n    float pose_ctrl_d;\n\t...\n\n};\n\n\n// 实现构造函数\nPX4CtrlFSM::PX4CtrlFSM(const ros::NodeHandle &amp;nh) : nh_(nh) {\n\t...\n\t// 使用boost::bind正确绑定PIDCallBack函数\n    cbType = boost::bind(&amp;mmc_ctrl::PX4CtrlFSM::PIDCallBack, this, _1, _2);\n  
  // 5.服务器对象调用回调对象\n    server.setCallback(cbType);\n\t...\n}\n\n\nvoid PX4CtrlFSM::PIDCallBack(px4ctrl::PIDConfig&amp; config, uint32_t level){\n    // ROS_INFO(&quot;动态参数&quot;);\n    pose_ctrl_p = config.p;\n    pose_ctrl_i = config.i;\n    pose_ctrl_d = config.d;\n\n}</pre> \n </div>\n</div><h4 id="ROS-动态调参-编译配置文件">编译配置
